# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me-to-something-long
# Friends need this code to register. Leave empty for open registration.
INVITE_CODE=
# Player names (comma separated) that may reset passwords in the game.
ADMINS=
# Only for the https profile: your domain, e.g. forge.example.org
DOMAIN=
# Port on the server when running without Caddy
APP_PORT=8080
# Test helpers for every player (resources, dwarves, looks, skip time). Admins always have them.
CHEATS=false
# A test account with a finished hold (every room, layer and city, 60 dwarves), made once at startup.
# Leave empty for none. Pick your own password; the account gets cheats.
DEMO_USER=
DEMO_PASSWORD=
